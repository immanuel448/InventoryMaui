<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="InventoryMaui.Views.ProductsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Productos">

    <!-- Grid principal con dos filas:
         - Fila 0: botones de acciones
         - Fila 1: lista de productos -->
    <Grid
        Padding="20"
        RowDefinitions="Auto,*">

        <!-- Botones de acción en la parte superior -->
        <HorizontalStackLayout
            Grid.Row="0"
            HorizontalOptions="End"
            Spacing="10"
            Margin="0,0,0,10">

            <Button
                Text="Nuevo producto"
                Command="{Binding GoToCreateCommand}" />

            <Button
                Text="Actualizar"
                Command="{Binding LoadProductsCommand}" />

        </HorizontalStackLayout>

        <!-- Lista de productos en la segunda fila -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Products}">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="0,10">

                        <!-- Nombre destacado -->
                        <Label
                            Text="{Binding Name}"
                            FontSize="18"
                            FontAttributes="Bold" />

                        <!-- Descripción -->
                        <Label
                            Text="{Binding Description}"
                            FontSize="14" />

                        <!-- Precio con formato moneda -->
                        <Label
                            Text="{Binding Price, StringFormat='Precio: {0:C}'}"
                            FontSize="14" />

                        <!-- Stock con formato -->
                        <Label
                            Text="{Binding Stock, StringFormat='Stock: {0}'}"
                            FontSize="14" />

                        <!-- Botón Editar: pasa el Id al comando del ViewModel -->
                        <Button
                            Text="Editar"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditProductCommand}"
                            CommandParameter="{Binding Id}" />

                        <!--botón Eliminar-->
                        <Button
                            Text="Eliminar"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteProductCommand}"
                            CommandParameter="{Binding Id}" />

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Spinner de carga, ocupa ambas filas -->
        <ActivityIndicator
            Grid.RowSpan="2"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

    </Grid>

</ContentPage>
